{
    "name": "backend",
    "version": "1.0.0",
    "packageManager": "pnpm@11.3.0",
    "description": "",
    "main": "src/index.js",
    "scripts": {
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build-css": "pnpm exec @tailwindcss/cli -i public/css/tailwind.css -o public/css/app.css --minify",
        "start": "node dist/index.js",
        "build": "tsc -p .",
        "dev": "nodemon src/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "allowScripts": {
        "@parcel/watcher": true,
        "argon2": true,
        "esbuild": true
    },
    "keywords": [],
    "author": "byeoon",
    "license": "ISC",
    "dependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@types/argon2": "^0.15.4",
        "argon2": "^0.45.1",
        "body-parser": "^1.20.6",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.6.1",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "express": "^4.22.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "1.4.5-lts.2",
        "mysql2": "^3.24.4",
        "nodemailer": "^6.10.1",
        "path": "^0.12.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/node": "^26.5.1",
        "@vitest/coverage-v8": "^5.0.0",
        "daisyui": "^5.7.28",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0"
    }
}
